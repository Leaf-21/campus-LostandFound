# 生产部署环境变量示例（复制为 .env.docker 后填写真实值，切勿提交真实密钥）
# 用法：docker compose --env-file .env.docker up -d --build

# --- 数据库 ---
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=campus_lost_found

# --- 后端 ---
BACKEND_PORT=3000
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=2h

# 允许的前端来源（多个用英文逗号分隔），生产必须改成真实域名
CORS_ORIGIN=http://localhost:5173
# 上传图片对外可访问地址前缀，生产必须改成真实域名
PUBLIC_BASE_URL=http://localhost:3000

MAX_FILE_SIZE_MB=5

# --- 初始账号（Seed 使用）---
ADMIN_ACCOUNT=admin
ADMIN_PASSWORD=change_this_admin_password
DEMO_USER_PASSWORD=change_this_demo_password
